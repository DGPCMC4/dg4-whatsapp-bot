# Configuración de WhatsApp (Directorio DG4)
#
# Llena estos 4 valores con lo que te dé la pantalla de Meta for Developers
# (pestaña WhatsApp > Configuración de la API).
#
# IMPORTANTE: este archivo tiene credenciales sensibles. No lo compartas,
# no lo mandes por correo/chat, no lo subas a ningún repositorio público.

# Pégalo tal cual aparece en "Phone Number ID"
PHONE_NUMBER_ID=1289099420958972

# El "Token de acceso" que genera el botón "Generar token" (empieza con EAAG...)
# Cámbialo cada vez que lo regeneres en el panel de Meta.
WHATSAPP_ACCESS_TOKEN=

# Cualquier palabra/frase secreta que tú inventes (ej. dg4-verificacion-2026).
# Se usa solo para que Meta confirme que el webhook es tuyo. No la comparas con nadie.
WHATSAPP_VERIFY_TOKEN=dg4-verificacion-2026
